PORT=3000
DATABASE_PATH=./data/drawdb.sqlite

# The API and WebSocket are unauthenticated, so the listener defaults to
# loopback. Put a tunnel or reverse proxy in front rather than widening this.
BIND_HOST=127.0.0.1

# Only set when a reverse proxy is guaranteed in front; otherwise clients can
# forge X-Forwarded-For.
# TRUST_PROXY=1

# Extra origins allowed to open a WebSocket, comma separated. Same-origin is
# always allowed; this is only needed when the app is served from another host.
# ALLOWED_ORIGINS=https://drawdb.example.com
